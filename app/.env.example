# Copy to .env.local for local development. In Vercel, set these under
# Project Settings > Environment Variables.

# Postgres connection string for the read-only app role (see ../db/app_role.sql).
# Supabase > Project Settings > Database > Connection string. The username for
# the pooler is  aotd_app.<project-ref>.
DATABASE_URL=

# Any long random string. Vercel sends it to /api/cron/refresh automatically.
CRON_SECRET=

# Optional: where the "Built by" footer link points.
NEXT_PUBLIC_PORTFOLIO_URL=
