# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# Spotify Web API — create an app at https://developer.spotify.com/dashboard
# Only the Client Credentials flow is used (public catalog data), so no
# redirect URI or user login is required.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Postgres / Supabase — Project Settings > Database > Connection string (URI).
# Use the pooled connection string (port 6543) for scheduled jobs.
DATABASE_URL=
DB_SCHEMA=bandcamp

# Crawler politeness — raise these if Bandcamp starts rate limiting.
BANDCAMP_REQUEST_DELAY=0.75
BANDCAMP_INDEX_DELAY=2.0
